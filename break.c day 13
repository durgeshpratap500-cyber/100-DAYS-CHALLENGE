#include<stdio.h>
void main(){
int a,b;
char op;
printf("enter two number");
scanf("%c",&op);
switch(op)
{
case'+':
printf("answer=%d",a+b);
break;
case'-':
printf("answer=%d",a-b);
break;
case'*':
printf("answer=&d",a*b);
break;
case'/':
printf("answer=&d",a/b);
break;
case'%':
printf("answer=&d",a%b);
break;
default:
printf("invalid operator");
}
}