#include<stdio.h>
void main(){
int days;
printf("enter the number from 1 to 7");
scanf("%d",&days);
switch(days)
{
case1:
printf("monday");
break;
case2:
printf("tuesday");
break;
case3:
printf("wednesday");
break;
case4:
printf("thursday");
break;
case5:
printf("friday");
break;
case6:
printf("saturday");
break;
case7:
printf("sundat");
break;
default:
printf("invalid number");
}
}
