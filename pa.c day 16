//program to check whether the no is palindrome or not
#include<stdio.h>
void main(){
int num,original,reverse=0,remainder;
printf("enter the number");
scanf("%d",&num);
original=num;
while(num!=0){
remainder=num%10;
reverse=reverse*10+remainder;
num/=10;
}
if(original==reverse)
printf("%d is a pllindrome\n",original);
else 
printf("%d is not pallindrome\n",original);
}