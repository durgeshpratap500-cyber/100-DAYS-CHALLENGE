#include<stdio.h>
#include<math.h>
void main(){
float a,b,c,d,x1,x2;
printf("enter a,b,c");
scanf("%f%f%f",&a,&b,&c);
d=b*b-4*a*c;
if(d>0){
x1=(-b+sqrt(d)/(2*a));
x2=(-b-sqrt(d)/(2*a));
printf("two different roots\n");
printf("roots=%.2f and %.2f",x1,x2);}
else if(d==0){
x1=-b/(2*a);
printf("two equal roots\n");
printf("root=%.2f",x1);}
else{
printf("no real roots");}
}